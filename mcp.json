{
  "name": "hypnotic-meditations",
  "version": "2.0.0",
  "displayName": "Hypnotic Meditations",
  "description": "Source-dated product recommendations with local operator SOP links. Check live checkout for current price.",
  "homepage": "https://hypnoticmeditations.ai",
  "icon": "https://hypnoticmeditations.ai/favicon.ico",
  "categories": [
    "health-wellness",
    "ecommerce"
  ],
  "tools": [
    {
      "name": "get_recommendation"
    },
    {
      "name": "list_products"
    },
    {
      "name": "get_offer_details"
    },
    {
      "name": "get_business_context",
      "scope": "local-stdio-only"
    }
  ],
  "server": {
    "type": "stdio",
    "command": "node",
    "args": [
      "index.js"
    ]
  },
  "repository": "https://github.com/seanmillionaire/hypnotic-meditations-mcp",
  "license": "MIT"
}
